# Normalize line endings to LF for text files.
* text=auto eol=lf

# The compiled eBPF objects are committed so that building this project needs
# only Go. They are binary, and diffing them is meaningless.
*.o binary

# Generated files: collapse in diffs and exclude from language stats.
#
# The bpf2go output is regenerated by `just bpf-generate` and verified in CI by
# `just bpf-verify`, so it is never hand-edited. Marking it keeps GitHub from
# reporting this as a project full of machine-written Go.
internal/detector/bpf/*_bpfel.go linguist-generated=true
CHANGELOG.md linguist-generated=true
go.sum linguist-generated=true

# The eBPF probe is C, but it is a small and central part of the project rather
# than vendored code, so it deliberately still counts toward language stats.

# Documentation should not count toward language stats.
docs/** linguist-documentation=true
examples/** linguist-documentation=true
